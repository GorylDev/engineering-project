{
  "name": "olfunara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": "11.25.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate --config prisma.config.ts && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node --conditions=react-server --import tsx scripts/database.ts integration",
    "test:e2e": "node --conditions=react-server --import tsx scripts/database.ts e2e",
    "test:e2e:errors": "pnpm build && playwright test --config playwright.errors.config.ts",
    "db:migrate": "node --conditions=react-server --import tsx scripts/database.ts migrate",
    "db:seed": "node --conditions=react-server --import tsx scripts/database.ts seed",
    "db:test:prepare": "node --conditions=react-server --import tsx scripts/database.ts prepare-test",
    "db:test:reset": "node --conditions=react-server --import tsx scripts/database.ts reset-test",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "env:setup": "node --import tsx scripts/setup-env.ts",
    "postinstall": "prisma generate --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
